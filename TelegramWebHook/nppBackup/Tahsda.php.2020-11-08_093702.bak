<?php 

$TOKEN = "1407371149:AAE3pkDoYYTunfvhRZGmutntxho3quMSdtc";
$API_URL = "https://api.telegram.org/bot$TOKEN/";  #網址最後的斜線不可刪除
//$API_URL = "https://api.telegram.org/bot$TOKEN/sendMessage";  

$content = file_get_contents("php://input");
$date = new DateTime();
error_log("Input ".$content."\n", 3, "TahsdaWebHook".$date->format('Ymd').".log");
//error_log("Input ".$content."\n", 3, "TahsdaWebHook".$date->format('Y-m-d_H:i:s').".log");

$update = json_decode($content, true);
$chatID = $update["message"]["chat"]["id"];
$MessageText = $update["message"]["text"];

$inlineQuery = isset($update["inline_query"]) ? $update["inline_query"] : ""; 

$inline_keyboard = array();
switch ($MessageText) {
	case '/start':
		$inline_keyboard = array("orange", "banana");
		array_push($inline_keyboard, array("text"=>"臺安官網","url"=>"https://www.tahsda.org.tw"));
		array_push($inline_keyboard, array("text"=>"test","callback_data"=>'/test'));
	
}	
print_r($inline_keyboard);
//$inline_button1 = array("text"=>"臺安官網","url"=>"https://www.tahsda.org.tw");
//$inline_button2 = array("text"=>"test","callback_data"=>'/test');
//$inline_keyboard = [[$inline_button1,$inline_button2]];
$keyboard=array("inline_keyboard"=>$inline_keyboard);
$replyMarkup = json_encode($keyboard);
$parameters["reply_markup"] = $replyMarkup;

$parameters["method"] = 'sendMessage';
$parameters["chat_id"] = $chatID;
$parameters["text"] = 'helloWorld';

$handle = curl_init($API_URL);
curl_setopt($handle, CURLOPT_RETURNTRANSFER, true);
curl_setopt($handle, CURLOPT_CONNECTTIMEOUT, 5);
curl_setopt($handle, CURLOPT_TIMEOUT, 60);
curl_setopt($handle, CURLOPT_POST, true);
curl_setopt($handle, CURLOPT_POSTFIELDS, json_encode($parameters));
//curl_setopt($handle, CURLOPT_POSTFIELDS, ($Params));
curl_setopt($handle, CURLOPT_HTTPHEADER, array("Content-Type: application/json"));

$response = curl_exec($handle);
error_log("response ".$response."\n", 3, "TahsdaWebHook".$date->format('Ymd').".log");
echo $response;
 
