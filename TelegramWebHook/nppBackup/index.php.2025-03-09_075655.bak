<?php
// 取得來自 Telegram 的 Webhook JSON 資料
$update = json_decode(file_get_contents("php://input"), true);

if (isset($update["message"])) {
    $chat_id = $update["message"]["chat"]["id"]; // 取得 Chat ID
    $RecvMsgText = $update["message"]["text"]; // 取得使用者傳的文字
}


include("../fun/db.php");
try{
    $db=new PDO("mysql:host=".$hostname.";
                dbname=".$db_name, $username, $password,
                array(PDO::MYSQL_ATTR_INIT_COMMAND => "SET NAMES utf8"));
                //PDO::MYSQL_ATTR_INIT_COMMAND 設定編碼
                
    //echo '連線成功';
    $db->setAttribute(PDO::ATTR_ERRMODE,PDO::ERRMODE_EXCEPTION); //錯誤訊息提醒
    
} catch(PDOException $e){
    //error message
//    echo $e->getMessage(); 
	error_log(date("Y-m-d H:i:s")." 無法開啟資料庫"."\n", 3, "Log/".date("Y-m-d").".log");
} 


try{
      //Query SQL

	$sql="select id, name, LIFFID, Client_ID, LIFF_URL, URL, TelegramToken, TelegramChatID from Campus where Token = '".$_GET["Token"]."'";
//	echo $sql;
	error_log(date("Y-m-d H:i:s").$sql."\n", 3, "Log/".date("Y-m-d").".log");
	
	$stm = $db->query($sql);

	$Campus = $stm->fetch(PDO::FETCH_ASSOC);
	error_log(date("Y-m-d H:i:s").print_r($Campus, true)."\n", 3, "Log/".date("Y-m-d").".log");

} catch(PDOException $e){

	error_log(date("Y-m-d H:i:s")."Select Campus ".$e->getMessage()."\n", 3, "Log/".date("Y-m-d").".log");	
//	echo "{'Name':'無法讀取分校名'}";
}

if ($RecvMsgText == '/start') {
	sendMessage($chat_id, "請輸入學生的姓名以綁定通知", $Campus["TelegramToken"]);	
	exit;
}

try{
      //Query SQL
    $sql="select id, LineID, TelegramID, TelegramID1 from Student where name = '".$RecvMsgText."' and enable = 1 and CampusID = ".$Campus["id"];
	error_log(date("Y-m-d H:i:s").$sql."\n", 3, "Log/".date("Y-m-d").".log");
	
	$stm = $db->query($sql);

	$Student = $stm->fetch(PDO::FETCH_ASSOC);
	error_log(date("Y-m-d H:i:s")." ".gettype($Student)." ".print_r($Student, true)."\n", 3, "Log/".date("Y-m-d").".log");

} catch(PDOException $e){
	error_log(date("Y-m-d H:i:s")."Select Student ".$e->getMessage()."\n", 3, "Log/".date("Y-m-d").".log");	
} 
if ($Student == false) {
	error_log(date("Y-m-d H:i:s").gettype($RecvMsgText)."查無此學生".$RecvMsgText."\n", 3, "Log/".date("Y-m-d").".log");	
	$Rtn_MSG = '查無此學生 '.$RecvMsgText;
	// 發送回覆
	sendMessage($chat_id, $Rtn_MSG, $Campus["TelegramToken"]);	
	exit;
}	

if (strlen($Student["TelegramID"]) > 0) {
	error_log(date("Y-m-d H:i:s").$RecvMsgText." 此學生已綁定"."\n", 3, "Log/".date("Y-m-d").".log");	
	if ($Student["TelegramID"] == $chat_id) {
		$Rtn_MSG = $RecvMsgText.' 此學生已綁定 ';
		sendMessage($chat_id, $Rtn_MSG, $Campus["TelegramToken"]);	
		exit;
	}
}	

try{
	$sql = "update Student ";
	$sql .= " set MDT = now() ";
	if (strlen($Student["TelegramID"]) == 0)
		$sql .= ", TelegramID = :TelegramID ";
	else if ($Student["TelegramID"] != $chat_id)
		$sql .= ", TelegramID1 = :TelegramID ";
	$sql .= " where id = :StudentID ";
	error_log(date("Y-m-d H:i:s").$sql."\n", 3, "Log/".date("Y-m-d").".log");	
//	$stm = $db->query($sql);
    $stm=$db->prepare($sql);
    $stm->bindParam(":TelegramID", $chat_id );
	$stm->bindParam(":StudentID", $Student["id"] );
    $stm->execute();		
	error_log(date("Y-m-d H:i:s").$RecvMsgText." 此學生綁定成功"."\n", 3, "Log/".date("Y-m-d").".log");	
	$Rtn_MSG = $RecvMsgText.' 此學生綁定成功 ';	
//	echo '{"ClassName":"'.$rows["name"].'"}';

} catch(PDOException $e){
	error_log(date("Y-m-d H:i:s").$RecvMsgText." 此學生綁定失敗(Update)"."\n", 3, "Log/".date("Y-m-d").".log");	
	$Rtn_MSG = $RecvMsgText.' 此學生綁定失敗(Update) ';
} 


$logMessage = print_r($update, true);
error_log(date("Y-m-d H:i:s")."Token : ".$_GET["Token"]."\\n", 3, "Log/".date("Y-m-d").".log");
error_log(date("Y-m-d H:i:s").$logMessage."\\n", 3, "Log/".date("Y-m-d").".log");


// 發送回覆
sendMessage($chat_id, $Rtn_MSG, $Campus["TelegramToken"]);
	
// 發送訊息函式
function sendMessage($chat_id, $message, $BOT_TOKEN) {
    $url = "https://api.telegram.org/bot$BOT_TOKEN/sendMessage";
    
    $data = [
        'chat_id' => $chat_id,
        'text' => $message
    ];
    
    $options = [
        'http' => [
            'header'  => "Content-Type: application/json",
            'method'  => 'POST',
            'content' => json_encode($data),
        ],
    ];
    $context  = stream_context_create($options);
    file_get_contents($url, false, $context);
}

?>