# AllTrue production binlog for point-in-time recovery (#881).
# Installed by scripts/pi-enable-binlog.sh; removed by its --rollback.
# Option files take comments on their own line only.
[mysqld]
server_id = 1
log_bin = mysql-bin
binlog_format = ROW
# Keep 7 days of binlogs (the runbook's 3-7 day range).
binlog_expire_logs_seconds = 604800
max_binlog_size = 100M
