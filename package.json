{
  "name": "alltrue-system",
  "private": true,
  "type": "module",
  "description": "Root scripts for CI governance / Agent preflight (frontend lives in frontend/)",
  "scripts": {
    "build": "npm --prefix frontend run build",
    "lint:no-undef": "npm --prefix frontend run lint:no-undef",
    "ci:preflight": "node scripts/ci-preflight.mjs",
    "ci:preflight:self-test": "node scripts/ci-preflight.mjs --self-test",
    "sync:generated": "node scripts/sync-generated.mjs",
    "sync:generated:check": "node scripts/sync-generated.mjs --check",
    "test:gov": "node --test scripts/ci/gov.test.mjs && node scripts/ci-preflight.mjs --self-test"
  }
}
