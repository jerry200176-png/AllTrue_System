# AllTrue Daan staging — COPY to .env on the staging host only.
# NEVER copy production .env, Pi secrets, or production database dumps here.

APP_NAME=AllTrue-Staging
APP_ENV=staging
APP_DEBUG=false
APP_URL=http://127.0.0.1:18080
APP_KEY=

LOG_CHANNEL=stderr
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Staging MySQL (Docker service name `mysql`) — synthetic credentials only.
STAGING_DB_DATABASE=alltrue_stage
STAGING_DB_USERNAME=alltrue_stage
STAGING_DB_PASSWORD=CHANGE_ME_staging_only
STAGING_MYSQL_ROOT_PASSWORD=CHANGE_ME_staging_root_only

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=alltrue_stage
DB_USERNAME=alltrue_stage
DB_PASSWORD=CHANGE_ME_staging_only

# Explicitly off — staging is not a TrueFit activation surface.
TRUEFIT_V1=false
VITE_TRUEFIT_V1=false
