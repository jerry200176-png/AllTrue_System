# Staging web tier: builds the Vue SPA (vite build only; CI already ran the lint/unit gates)
# and serves it with nginx next to the PHP-FPM API. Own ignore file: Dockerfile.web.dockerignore.
FROM node:22-slim AS fe
COPY . /repo
WORKDIR /repo/frontend
ENV NODE_OPTIONS=--max-old-space-size=1280
# postinstall (scripts/sync-generated.mjs) writes the generated release-note modules
RUN npm ci --no-audit --no-fund && npx vite build

FROM nginx:1.25-alpine
COPY --from=fe /repo/frontend/dist_build /srv/web
