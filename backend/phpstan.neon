parameters:
    level: 5
    paths:
        - app
    # #545：baseline 既有問題，讓 PHPStan 之後只對「新增」問題報錯，
    # 以便穩定全綠後可從 advisory 升為 backend PR required gate。
    # PHPStan 2.x：預設將 unmatched baseline entries 視為 error；關閉以維持 baseline 相容性
    reportUnmatchedIgnoredErrors: false
includes:
    - phpstan-baseline.neon
