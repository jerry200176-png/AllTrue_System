{
  "name": "laravel/laravel",
  "type": "project",
  "require": {
    "guzzlehttp/guzzle": "^7.12.1",
    "laravel/framework": "^8.75",
    "laravel/sanctum": "^2.11",
    "laravel/tinker": "^2.5",
    "maatwebsite/excel": "^3.1",
    "pusher/pusher-php-server": "^7.0",
    "sentry/sentry-laravel": "^4.25"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^5.11",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/",
      "Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform-check": false,
    "platform": {
      "php": "8.2.30"
    },
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "audit": {
      "ignore": {
        "GHSA-5vg9-5847-vvmq": "Reachability reviewed 2026-07-12: no Laravel email validation rule or outbound mail to user-supplied addresses; Laravel 8 uses SwiftMailer. Framework EOL migration remains tracked in #977."
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
