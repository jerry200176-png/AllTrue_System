APP_NAME=AllTrueAdmin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alltrue
DB_USERNAME=root
DB_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LIFF_ID=

# ── Performance Feature Flags (rollback: set to old values) ──
# Throttle notification sync (true=optimized, false=old always-sync)
PERF_THROTTLE_NOTIF_SYNC=true
# Sync cooldown in seconds (only if throttle=true; old: 0)
PERF_NOTIF_SYNC_COOLDOWN=300
# Learning records default per_page (old: 200, optimized: 50)
PERF_LR_DEFAULT_PER_PAGE=50
# Learning records max per_page safety cap
PERF_LR_MAX_PER_PAGE=200
# Default time window (days) for LearningRecords initial fetch. 0 disables.
PERF_LR_DEFAULT_WINDOW_DAYS=90

# Sentry 錯誤追蹤（從 sentry.io 取得 DSN）
SENTRY_LARAVEL_DSN=
# CSP Report-Only — 從 DSN 拆解：https://<key>@<org>.ingest.us.sentry.io/<project_id>
SENTRY_CSP_REPORT_KEY=
SENTRY_CSP_REPORT_ORG=
SENTRY_CSP_REPORT_PROJECT_ID=
