###############################################################################
# AllTrue — Docker Environment Configuration
#
# Copy this file to .env before running: docker-compose up -d --build
#   cp backend/.env.docker backend/.env
#
# IMPORTANT: Change APP_KEY and DB_PASSWORD before going to production!
###############################################################################

APP_NAME=AllTrueAdmin
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack

# ── Database (PostgreSQL container) ──────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=alltrue
DB_USERNAME=alltrue
DB_PASSWORD=secret
DB_SSLMODE=prefer

# ── Auth / Session ───────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
