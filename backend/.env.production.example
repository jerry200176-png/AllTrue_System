APP_NAME=AllTrueAdmin
APP_ENV=production
APP_KEY=base64:REPLACE_ME
APP_DEBUG=false
# Cloudflare Tunnel 對外網址，必須為 https（例：https://xxx.trycloudflare.com 或自訂網域）
APP_URL=https://REPLACE_ME.trycloudflare.com

LOG_CHANNEL=stack

# Database（Docker Compose 時使用 postgres 服務）
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=${DB_DATABASE:-alltrue}
DB_USERNAME=${DB_USERNAME:-alltrue}
DB_PASSWORD=${DB_PASSWORD:-secret}

# Session / Cookie（外網 HTTPS 必設，避免登入掉線）
# SESSION_DOMAIN 留空表示綁定當前 host；子網域共用可填 .your-domain.com
SESSION_DOMAIN=
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Sanctum：前端 SPA 登入後 cookie 要送出的網域，需包含 Cloudflare 網址（與 APP_URL 同 host）
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,REPLACE_ME.trycloudflare.com
