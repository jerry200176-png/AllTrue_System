  "groups": [{ "id": "ci-evidence", "label": "CI evidence", "lane": "ci", "fromCol": 1, "toCol": 2, "variant": "emphasis" }, { "id": "activation-gate", "label": "Protected activation", "lane": "control", "fromCol": 3, "toCol": 4, "variant": "security" }],
