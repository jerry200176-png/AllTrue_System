{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.schema.json",
  "testRunner": "command",
  "commandRunner": { "command": "node --test scripts/tests/land-queue.test.mjs scripts/tests/autoland.test.mjs scripts/tests/stryker-diff-ranges.test.mjs" },
  "coverageAnalysis": "off",
  "inPlace": true,
  "concurrency": 2,
  "timeoutMS": 60000,
  "reporters": ["json", "clear-text"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
